@model Web.ViewModels.CreateRentalViewModel

@{
    ViewData["Title"] = "Zapùjèení kola";
}

<h1 class="mb-4">Zapùjèení kola</h1>

<form asp-controller="Rentals" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <input asp-for="BikeId" type="hidden" />
    <input asp-for="StationId" type="hidden" />
    <input asp-for="BikeCode" type="hidden" />
    <input asp-for="StationName" type="hidden" />

    <div class="card mb-4">
        <div class="card-header">
            Vybrané kolo
        </div>

        <div class="card-body">
            <p class="mb-2">
                <strong>Kolo:</strong> @Model.BikeCode
            </p>

            <p class="mb-0">
                <strong>Výchozí stanice:</strong> @Model.StationName
            </p>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="EstimatedTargetStationId" class="form-label">
            Odhadovaná cílová stanice
        </label>

        <select asp-for="EstimatedTargetStationId"
                asp-items="Model.TargetStationOptions"
                class="form-select">
            <option value="">-- vyber cílovou stanici --</option>
        </select>

        <span asp-validation-for="EstimatedTargetStationId" class="text-danger"></span>

        <div class="form-text">
            Stanice nesmí mít více než 3 aktuálnì umístìná kola.
        </div>
    </div>

    <div class="form-check mb-4">
        <input asp-for="AgreeToTerms" class="form-check-input" />
        <label asp-for="AgreeToTerms" class="form-check-label">
            Souhlasím s podmínkami zapùjèení kola.
        </label>
        <br />
        <span asp-validation-for="AgreeToTerms" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Zapùjèit
        </button>

        <a asp-controller="Stations"
           asp-action="Details"
           asp-route-id="@Model.StationId"
           class="btn btn-secondary">
            Zpìt
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}