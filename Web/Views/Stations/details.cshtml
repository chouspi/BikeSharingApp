@model Web.Dtos.StationDetailDto

@{
    ViewData["Title"] = "Detail stanoviště";
}

<h1>Detail stanoviště</h1>

<div class="card mb-4">
    <div class="card-body">
        <h3 class="card-title">@Model.Name</h3>

        <p class="mb-1">
            <strong>Adresa:</strong> @Model.Address
        </p>

        <p class="mb-1">
            <strong>GPS:</strong> @Model.Latitude, @Model.Longitude
        </p>

        <p class="mb-1">
            <strong>Dostupná kola:</strong> @Model.AvailableBikes
        </p>

        <p class="mb-1">
            <strong>Celkem kol:</strong> @Model.TotalBikes
        </p>
    </div>
</div>

<h2>Dostupná kola</h2>

@if (Model.AvailableBikesList.Count == 0)
{
    <div class="alert alert-warning">
        Na tomto stanovišti nejsou aktuálně dostupná žádná kola.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Kód kola</th>
                <th>Stav</th>
                <th>Akce</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var bike in Model.AvailableBikesList)
            {
                <tr>
                    <td>@bike.Code</td>
                    <td>@bike.Status</td>
                    <td>
                        <a asp-controller="Rentals" asp-action="Create" asp-route-bikeId="@bike.Id" asp-route-stationId="@Model.Id">Zapůjčit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Stations" asp-action="Index" class="btn btn-secondary">
    Zpatky
</a>
