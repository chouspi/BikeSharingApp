@model List<Web.Dtos.StationStatisticDto>

@{
    ViewData["Title"] = "Statistika";
}

<h1>Statistika za posledni mesic</h1>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Stanice</th>
            <th>Zapujceno</th>
            <th>Vraceno</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var station in Model)
        {
            <tr>
                <td>@station.StationName</td>
                <td>@station.StartedCount</td>
                <td>@station.FinishedCount</td>
            </tr>
        }
    </tbody>
</table>
